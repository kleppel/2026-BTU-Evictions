library(shiny)
library(ISLR)
data('Hitters')
hitters <- na.omit(Hitters)
ui <- fluidPage(
selectInput('xvar', 'X - Axis:', choices = names(hitters)),
selectInput('yvar', 'Y - Axis:', choices = names(hitters)),
plotOutput('scatter')
)
server <- function(input, output) {
output$scatter <- renderPlot({
plot(hitters[[input$xvar]], hitters[[input$yvar]],
xlab = input$xvar, ylab = input$yvar)
})
}
shinyApp(ui = ui, server = server)
