defdist <- function(df, array_col) {
parsed <- lapply(df[[array_col]], function(x) {
as.numeric(strsplit(gsub('\\{|\\}', '', x), ',')[[1]])
})
dist_df <- as.data.frame(do.call(rbind, parsed))
colnames(dist_df) <- paste0('def_dist_t', 1:4)
df <- df %>%
bind_cols(dist_df) %>%
select(-all_of(array_col))
return(df)
}
data <- defdist(data, 'closestdefapproach')
set.seed(42)
split <- initial_split(data, prop = 0.8, strata = shot_made)
train <- training(split)
test  <- testing(split)
shot <- recipe(shot_made ~ ., data = train) %>%
step_rm(outcome, shot_id, contester1_id, contester2_id, contester3_id, contester4_id,
distcont1, distcont2, distcont3, distcont4) %>%
step_lencode_mixed(shooter_id, closestdef_id, outcome = vars(shot_made)) %>%
step_dummy(all_nominal_predictors()) %>%
step_normalize(all_numeric_predictors())
prepped <- prep(shot, training = train)
baked <- bake(prepped, new_data = NULL)
rf_spec <- rand_forest(trees = 500) %>%
set_engine('ranger', importance = 'impurity') %>%
set_mode('classification')
rf_wf <- workflow() %>%
add_recipe(shot) %>%
add_model(rf_spec)
rf_fit <- rf_wf %>%
fit(data = train)
rf_wf <- workflow() %>%
add_recipe(shot) %>%
add_model(rf_spec)
rf_fit <- rf_wf %>%
fit(data = train)
